{
  "name": "Healing 1 - Container Crash",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "seconds", "secondsInterval": 60 }]
        }
      },
      "name": "Schedule Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://172.31.30.184:80",
        "options": {
          "timeout": 5000,
          "allowUnauthorizedCerts": true
        }
      },
      "name": "Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "exists", "singleValue": true }
            }
          ],
          "combinator": "or"
        }
      },
      "name": "Is Down?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "command": "docker start nginx"
      },
      "name": "L1 - Restart Container",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [900, 200],
      "credentials": {
        "sshPassword": {
          "id": "AZJNKVBkx1kjta7Z",
          "name": "Worker Node SSH"
        }
      }
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "name": "Wait 30s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "url": "http://172.31.30.184:80",
        "options": { "timeout": 5000 }
      },
      "name": "Verify Recovery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 200],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "exists", "singleValue": true }
            }
          ],
          "combinator": "or"
        }
      },
      "name": "Still Down?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "command": "sudo reboot"
      },
      "name": "L2 - Reboot Instance",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [1780, 100],
      "credentials": {
        "sshPassword": {
          "id": "AZJNKVBkx1kjta7Z",
          "name": "Worker Node SSH"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://172.31.30.184:3000/api/annotations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '[Healing 1] Container Crash — L1: docker start nginx — Result: OK', tags: ['self-healing', 'container-crash'] }) }}"
      },
      "name": "Annotation - L1 OK",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "3ZUB5dPlNwNIeiR0",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://172.31.30.184:3000/api/annotations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '[Healing 1] Container Crash — L1 FAILED — L2: Reboot Instance', tags: ['self-healing', 'container-crash', 'escalation'] }) }}"
      },
      "name": "Annotation - L2 Escalation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "3ZUB5dPlNwNIeiR0",
          "name": "Header Auth account"
        }
      }
    }
  ],
  "connections": {
    "Schedule Check": {
      "main": [
        [{ "node": "Health Check", "type": "main", "index": 0 }]
      ]
    },
    "Health Check": {
      "main": [
        [{ "node": "Is Down?", "type": "main", "index": 0 }]
      ]
    },
    "Is Down?": {
      "main": [
        [{ "node": "L1 - Restart Container", "type": "main", "index": 0 }],
        []
      ]
    },
    "L1 - Restart Container": {
      "main": [
        [{ "node": "Wait 30s", "type": "main", "index": 0 }]
      ]
    },
    "Wait 30s": {
      "main": [
        [{ "node": "Verify Recovery", "type": "main", "index": 0 }]
      ]
    },
    "Verify Recovery": {
      "main": [
        [{ "node": "Still Down?", "type": "main", "index": 0 }]
      ]
    },
    "Still Down?": {
      "main": [
        [{ "node": "L2 - Reboot Instance", "type": "main", "index": 0 }],
        [{ "node": "Annotation - L1 OK", "type": "main", "index": 0 }]
      ]
    },
    "L2 - Reboot Instance": {
      "main": [
        [{ "node": "Annotation - L2 Escalation", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
